        // عرض بطاقات الكانجي في الصفحة
        function renderKanjiGrid() {
            const container = document.getElementById('kanji-n5');
            container.innerHTML = '';

            kanjiN5Data.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = 'kanji-card';
                card.innerHTML = `
                    <button class="info-btn" onclick="openInfoModal(${index})" title="شرح الكانجي بالعربية">!</button>
                    <div class="kanji-symbol">${item.kanji}</div>
                    <div class="kanji-meaning-ar">${item.meaningAr}</div>
                    <div class="kanji-readings">
                        <strong>Kun:</strong> ${item.kunyomi}<br>
                        <strong>On:</strong> ${item.onyomi}
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // فتح نافذة الشرح بالعربية عند الضغط على !
        function openInfoModal(index) {
            const data = kanjiN5Data[index];
            const modalBody = document.getElementById('modalBody');

            let examplesHTML = '';
            data.examples.forEach(ex => {
                examplesHTML += `
                    <li class="example-item">
                        <span class="jp-word">${ex.jp}</span> 
                        <span class="jp-reading">(${ex.read})</span>
                        <span class="ar-meaning">${ex.ar}</span>
                    </li>
                `;
            });

            modalBody.innerHTML = `
                <div class="modal-header">
                    <div class="modal-kanji">${data.kanji}</div>
                    <div class="modal-title-info">
                        <h2>${data.meaningAr}</h2>
                        <span style="color:#777;">${data.meaningEn}</span>
                    </div>
                </div>

                <div class="modal-section">
                    <h4>💡 شرح الرمز وتركيبه:</h4>
                    <p style="margin:0; color:#444; line-height:1.6;">${data.explanation}</p>
                </div>

                <div class="modal-section">
                    <h4>🗣️ القراءات اليابانية:</h4>
                    <p style="margin:0;"><strong>Kun-yomi (ياباني):</strong> ${data.kunyomi}</p>
                    <p style="margin:0;"><strong>On-yomi (صيني):</strong> ${data.onyomi}</p>
                </div>

                <div class="modal-section">
                    <h4>📚 أمثلة وكلمات شائعة:</h4>
                    <ul class="example-list">
                        ${examplesHTML}
                    </ul>
                </div>
            `;

            document.getElementById('infoModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('infoModal').style.display = 'none';
        }

        function closeModalOnOverlay(e) {
            if (e.target.id === 'infoModal') {
                closeModal();
            }
        }

